{
  "codeConnect": {
    "parser": "react",
    "include": [
      "src/components/**/*.figma.tsx",
      "src/components/**/*.tsx"
    ],
    "react": {
      "importPaths": {
        "@/components/*": "src/components/*",
        "@/lib/tokens/*": "src/lib/tokens/*"
      }
    },
    "paths": {
      "@/*": ["src/*"]
    }
  }
}